# URL pública do site, sem barra no final. Usada em SEO (canonical, Open Graph, sitemap, JSON-LD).
# Na Vercel, sem ela o site usa o domínio de produção do projeto automaticamente.
NEXT_PUBLIC_SITE_URL=

# Google Search Console, método "Tag HTML": cole o código (ou a meta tag inteira). Opcional.
GOOGLE_SITE_VERIFICATION=

# Painel /keystatic em produção (GitHub App). Sem estas variáveis o painel fica desligado
# em produção; em dev ele grava direto nos arquivos locais. Setup em docs/PAINEL.md.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Só em dev, só no setup inicial: força o modo GitHub para criar o GitHub App.
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github
